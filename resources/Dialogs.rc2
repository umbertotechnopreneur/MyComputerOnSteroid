// One geometry for every language. Text is assigned from localized resources
// before display; all coordinates are dialog units based on this Segoe UI font.
IDD_THIS_PC_ENTRIES DIALOGEX 0, 0, 540, 274
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DIALOG_HEADING, 12, 10, 516, 16
    LTEXT "", IDC_THIS_PC_DESCRIPTION, 12, 30, 516, 20
    CONTROL "", IDC_DIALOG_HEADER_LINE, "Static", SS_ETCHEDHORZ, 12, 56, 516, 1
    LTEXT "", IDC_THIS_PC_LIST_LABEL, 12, 70, 224, 10
    CONTROL "", IDC_THIS_PC_LIST, "SysListView32", LVS_ICON | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 86, 224, 142
    LTEXT "", IDC_THIS_PC_MODE, 254, 70, 274, 12
    RTEXT "", IDC_THIS_PC_NAME_LABEL, 254, 89, 58, 10
    EDITTEXT IDC_THIS_PC_NAME, 320, 86, 208, 14, ES_AUTOHSCROLL | WS_TABSTOP
    RTEXT "", IDC_THIS_PC_TARGET_LABEL, 254, 115, 58, 10
    EDITTEXT IDC_THIS_PC_TARGET, 320, 112, 122, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "", IDC_THIS_PC_CHOOSE_FOLDER, 448, 111, 80, 15
    RTEXT "", IDC_THIS_PC_ICON_LABEL, 254, 141, 58, 10
    EDITTEXT IDC_THIS_PC_ICON, 320, 138, 122, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON "", IDC_THIS_PC_CHOOSE_ICON, 448, 137, 80, 15
    CONTROL "", IDC_THIS_PC_PREVIEW, "Static", SS_ICON | SS_CENTERIMAGE, 320, 168, 28, 28
    CONTROL "", IDC_DIALOG_FOOTER_LINE, "Static", SS_ETCHEDHORZ, 12, 240, 516, 1
    PUSHBUTTON "", IDC_THIS_PC_NEW, 12, 250, 86, 14
    PUSHBUTTON "", IDC_THIS_PC_REMOVE, 104, 250, 62, 14
    PUSHBUTTON "", IDC_SHOW_ABOUT, 172, 250, 76, 14
    DEFPUSHBUTTON "", IDC_THIS_PC_SAVE, 354, 250, 98, 14
    PUSHBUTTON "", IDCANCEL, 458, 250, 70, 14
END


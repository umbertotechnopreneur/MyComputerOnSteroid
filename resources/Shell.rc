IDD_THIS_PC_ENTRIES DIALOGEX 0, 0, 390, 246
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gestisci cartelle in Questo PC"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Cartelle mostrate direttamente in Questo PC", -1, 8, 8, 374, 12
    LISTBOX IDC_THIS_PC_LIST, 8, 23, 374, 78, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "Nome:", -1, 8, 112, 62, 12
    EDITTEXT IDC_THIS_PC_NAME, 74, 110, 308, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Cartella:", -1, 8, 136, 62, 12
    EDITTEXT IDC_THIS_PC_TARGET, 74, 134, 216, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Scegli cartella...", IDC_THIS_PC_CHOOSE_FOLDER, 296, 133, 86, 14
    LTEXT "Icona:", -1, 8, 160, 62, 12
    EDITTEXT IDC_THIS_PC_ICON, 74, 158, 216, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Scegli icona...", IDC_THIS_PC_CHOOSE_ICON, 296, 157, 86, 14
    LTEXT "Scegli una cartella, dai un nome e scegli un'icona se vuoi. Salva modifica solo questa voce; Rimuovi non cancella mai la cartella reale.", -1, 8, 184, 374, 24
    PUSHBUTTON "Rimuovi", IDC_THIS_PC_REMOVE, 8, 222, 58, 14
    DEFPUSHBUTTON "Salva", IDC_THIS_PC_SAVE, 264, 222, 56, 14
    PUSHBUTTON "Chiudi", IDCANCEL, 326, 222, 56, 14
END

IDD_VIEW_OPTIONS DIALOGEX 0, 0, 380, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cerca e organizza"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Ricerca", -1, 8, 8, 364, 80
    CONTROL "", IDC_VIEW_SEARCH_ICON, "Static", SS_ICON, 18, 23, 16, 16
    RTEXT "Cerca:", -1, 38, 23, 54, 12
    EDITTEXT IDC_VIEW_QUERY, 100, 21, 260, 14, ES_AUTOHSCROLL
    RTEXT "Cerca in:", -1, 38, 47, 54, 12
    COMBOBOX IDC_VIEW_FIELD, 100, 45, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Solo elementi del launcher e recenti abilitati. Non cerca dentro le cartelle.", IDC_VIEW_SEARCH_HINT, 100, 65, 260, 20
    GROUPBOX "Visualizzazione", -1, 8, 94, 364, 82
    CONTROL "", IDC_VIEW_GROUP_ICON, "Static", SS_ICON, 18, 109, 16, 16
    RTEXT "Raggruppa per:", -1, 38, 109, 54, 12
    COMBOBOX IDC_VIEW_GROUP, 100, 107, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Ordina per:", -1, 38, 133, 54, 12
    COMBOBOX IDC_VIEW_SORT, 100, 131, 150, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_VIEW_DIRECTION, 256, 131, 104, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Data: modifica della destinazione locale; aggiornamento della voce per i recenti. Date assenti: vuoto.", IDC_VIEW_DATE_HINT, 100, 152, 260, 20
    GROUPBOX "Famiglie di estensioni", -1, 8, 182, 364, 116
    CONTROL "", IDC_VIEW_FAMILY_ICON, "Static", SS_ICON, 18, 198, 16, 16
    EDITTEXT IDC_VIEW_FAMILIES, 44, 196, 316, 75, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT "Una per riga: Office = docx, xlsx, pptx. Ogni estensione va assegnata una volta. Dischi e cartelle mantengono i propri gruppi.", IDC_VIEW_FAMILY_HINT, 20, 275, 340, 20
    PUSHBUTTON "Azzera ricerca", IDC_VIEW_CLEAR, 12, 306, 84, 14
    DEFPUSHBUTTON "Applica", IDOK, 252, 306, 56, 14
    PUSHBUTTON "Annulla", IDCANCEL, 312, 306, 56, 14

#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_COLUMN_NAME "Name"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Umberto Giacobbi | umbertogiacobbi.biz"
            VALUE "FileDescription", "MyComputerOnSteroid Shell provider (bootstrap)"
            VALUE "FileVersion", "0.0.0.0"
            VALUE "InternalName", "MyComputerOnSteroid.Shell"
            VALUE "LegalCopyright", "Copyright (c) 2026 Umberto Giacobbi"
            VALUE "OriginalFilename", "MyComputerOnSteroid.Shell.dll"
            VALUE "ProductName", "MyComputerOnSteroid"
            VALUE "ProductVersion", "Unreleased"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

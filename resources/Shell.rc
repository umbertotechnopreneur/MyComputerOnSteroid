IDD_RECENT_FILTERS DIALOGEX 0, 0, 310, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Filtra recenti"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Mostra la sezione Recenti", IDC_RECENT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 280, 12
    LTEXT "Il nome contiene:", -1, 12, 33, 80, 12
    EDITTEXT IDC_RECENT_NAME, 96, 31, 202, 14, ES_AUTOHSCROLL
    LTEXT "Tipo:", -1, 12, 57, 80, 12
    COMBOBOX IDC_RECENT_CATEGORY, 96, 55, 202, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Estensione:", -1, 12, 81, 80, 12
    EDITTEXT IDC_RECENT_EXTENSION, 96, 79, 202, 14, ES_AUTOHSCROLL
    LTEXT "Vuoto per tutte le estensioni, oppure pdf, jpg, md...", -1, 96, 97, 202, 20
    LTEXT "Ordina per Data nei recenti dal menu Ordina o dalla colonna nella vista Dettagli. La data indica l'aggiornamento del collegamento nei recenti di Windows, non l'ultima apertura del documento.", -1, 12, 123, 286, 35
    DEFPUSHBUTTON "Applica", IDOK, 182, 168, 56, 14
    PUSHBUTTON "Annulla", IDCANCEL, 242, 168, 56, 14
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
#ifdef MCOS_EXECUTABLE
 FILETYPE VFT_APP
#else
 FILETYPE VFT_DLL
#endif
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Umberto Giacobbi | umbertogiacobbi.biz"
            VALUE "FileDescription", "MyComputerOnSteroid native launcher"
            VALUE "FileVersion", "0.0.0.0"
            VALUE "InternalName", "MyComputerOnSteroid"
            VALUE "LegalCopyright", "Copyright (c) 2026 Umberto Giacobbi"
#ifdef MCOS_EXECUTABLE
            VALUE "OriginalFilename", "MyComputerOnSteroid.exe"
#else
            VALUE "OriginalFilename", "MyComputerOnSteroid.Shell.dll"
#endif
            VALUE "ProductName", "MyComputerOnSteroid"
            VALUE "ProductVersion", "Unreleased"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

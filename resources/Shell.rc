LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_COLUMN_NAME "Name"
    IDS_FOLDERS "Folders"
    IDS_DRIVES "Devices and drives"
    IDS_APPS "Apps"
    IDS_FILES "Files"
    IDS_SECTION "Section"
    IDS_LOCATION "Location"
    IDS_ADD_FOLDER "Add favorite folder..."
    IDS_ADD_APP "Add favorite app..."
    IDS_ADD_FILE "Add favorite file..."
    IDS_MANAGE "Manage favorite shortcuts"
    IDS_ERROR_ADD "Could not add all selected favorites. Items already added remain available."
    IDS_ERROR_READ "Could not read the launcher items."
    IDS_ERROR_REMOVE "Could not remove all favorite references. Original items were preserved."
    IDS_CHANGE_ICON "Change launcher icon..."
    IDS_ICON_FILES "Icons (*.ico)"
    IDS_ERROR_ICON "Could not change all selected launcher icons. Original items were preserved."
    IDS_RECENTS "Recent items"
    IDS_RECENT_FILTERS "Filter recent items..."
    IDS_RECENT_SHOW "Show recent items"
    IDS_RECENT_RESTORE "Restore items hidden from recent items"
    IDS_RECENT_PIN "Pin in recent items"
    IDS_RECENT_UNPIN "Unpin from recent items"
    IDS_RECENT_HIDE "Hide from recent items"
    IDS_RECENT_ADD "Add to launcher favorites"
    IDS_RECENT_DATE "Recent entry updated"
    IDS_RECENT_PINNED "Pinned in recent items"
    IDS_PINNED_YES "Yes"
    IDS_ERROR_RECENTS "Could not update all recent items. Documents and Windows history were preserved."
    IDS_TYPE_ALL "All types"
    IDS_TYPE_DOCUMENTS "Documents (PDF, Word, Excel, Markdown...)"
    IDS_TYPE_IMAGES "Images"
    IDS_TYPE_AUDIO "Audio"
    IDS_TYPE_VIDEO "Video"
    IDS_TYPE_DEVELOPMENT "Development (CSS, HTML, JS, C++...)"
    IDS_TYPE_OTHER "Other"
    IDS_VIEW_OPTIONS "Search and organize..."
    IDS_CLEAR_SEARCH "Clear launcher search"
    IDS_EXTENSION "Extension"
    IDS_FAMILY "Extension family"
    IDS_ITEM_DATE "Item date (modified / recent)"
    IDS_NO_EXTENSION "No extension"
    IDS_OTHER_EXTENSIONS "Other extensions"
    IDS_GROUP_SECTIONS "Launcher sections"
    IDS_GROUP_EXTENSIONS "File extension"
    IDS_GROUP_FAMILIES "Custom extension families"
    IDS_GROUP_NONE "No grouping"
    IDS_SEARCH_ANY "Name, path or extension"
    IDS_SEARCH_NAME "Name contains"
    IDS_SEARCH_PATH "Target path contains"
    IDS_SEARCH_EXTENSION "Exact extension (pdf or .pdf)"
    IDS_SORT_NAME "Name"
    IDS_SORT_DATE "Item date"
    IDS_SORT_ASCENDING "Ascending"
    IDS_SORT_DESCENDING "Descending"
    IDS_FAMILY_DEFAULTS "PDF = pdf\r\nOffice = doc, docx, xls, xlsx, ppt, pptx\r\nDevelopment = c, cpp, h, hpp, cs, css, html, js, ts, json, md\r\nImages = jpg, jpeg, png, gif, webp, bmp, ico\r\nAudio = mp3, wav, flac, m4a, ogg\r\nVideo = mp4, mkv, avi, mov, webm\r\nApps = exe, com, cmd, bat, ps1"
    IDS_ERROR_VIEW "Could not apply search or view settings. Favorite references and original items were preserved."
    IDS_INVALID_FAMILIES "Use one family per line: Office = docx, xlsx, pptx. Use distinct family names and assign each extension only once. Up to 32 families, 60 characters per name."
    IDS_NO_SEARCH_RESULTS "No launcher items match this search. Right-click and choose Clear launcher search."
    IDS_MANAGE_THIS_PC "Manage This PC folders..."
    IDS_ERROR_THIS_PC "Could not update the folders shown directly in This PC. Their real folders were preserved."
END

IDD_THIS_PC_ENTRIES DIALOGEX 0, 0, 390, 246
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage This PC folders"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Folders shown directly in This PC", -1, 8, 8, 374, 12
    LISTBOX IDC_THIS_PC_LIST, 8, 23, 374, 78, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "Name:", -1, 8, 112, 62, 12
    EDITTEXT IDC_THIS_PC_NAME, 74, 110, 308, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Folder:", -1, 8, 136, 62, 12
    EDITTEXT IDC_THIS_PC_TARGET, 74, 134, 216, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Choose folder...", IDC_THIS_PC_CHOOSE_FOLDER, 296, 133, 86, 14
    LTEXT "Icon:", -1, 8, 160, 62, 12
    EDITTEXT IDC_THIS_PC_ICON, 74, 158, 216, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Choose icon...", IDC_THIS_PC_CHOOSE_ICON, 296, 157, 86, 14
    LTEXT "Choose a folder, give it a name and choose an icon if you want one. Save changes only this entry; Remove never deletes the real folder.", -1, 8, 184, 374, 24
    PUSHBUTTON "Remove", IDC_THIS_PC_REMOVE, 8, 222, 58, 14
    DEFPUSHBUTTON "Save", IDC_THIS_PC_SAVE, 264, 222, 56, 14
    PUSHBUTTON "Close", IDCANCEL, 326, 222, 56, 14
END

IDD_VIEW_OPTIONS DIALOGEX 0, 0, 380, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search and organize"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Search", -1, 8, 8, 364, 80
    CONTROL "", IDC_VIEW_SEARCH_ICON, "Static", SS_ICON, 18, 23, 16, 16
    RTEXT "Search:", -1, 38, 23, 54, 12
    EDITTEXT IDC_VIEW_QUERY, 100, 21, 260, 14, ES_AUTOHSCROLL
    RTEXT "Search in:", -1, 38, 47, 54, 12
    COMBOBOX IDC_VIEW_FIELD, 100, 45, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Launcher items and enabled recent items only. No search inside folders.", IDC_VIEW_SEARCH_HINT, 100, 65, 260, 20
    GROUPBOX "View", -1, 8, 94, 364, 82
    CONTROL "", IDC_VIEW_GROUP_ICON, "Static", SS_ICON, 18, 109, 16, 16
    RTEXT "Group by:", -1, 38, 109, 54, 12
    COMBOBOX IDC_VIEW_GROUP, 100, 107, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Sort by:", -1, 38, 133, 54, 12
    COMBOBOX IDC_VIEW_SORT, 100, 131, 150, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_VIEW_DIRECTION, 256, 131, 104, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Date: local target modification; history entry update for recent items. Missing dates stay empty.", IDC_VIEW_DATE_HINT, 100, 152, 260, 20
    GROUPBOX "Extension families", -1, 8, 182, 364, 116
    CONTROL "", IDC_VIEW_FAMILY_ICON, "Static", SS_ICON, 18, 198, 16, 16
    EDITTEXT IDC_VIEW_FAMILIES, 44, 196, 316, 75, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT "One per line: Office = docx, xlsx, pptx. Assign each extension once. Drives and folders keep their own groups.", IDC_VIEW_FAMILY_HINT, 20, 275, 340, 20
    PUSHBUTTON "Clear search", IDC_VIEW_CLEAR, 12, 306, 84, 14
    DEFPUSHBUTTON "Apply", IDOK, 252, 306, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 312, 306, 56, 14
END

IDD_RECENT_FILTERS DIALOGEX 0, 0, 310, 183
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recent item filters"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Show the Recent items section", IDC_RECENT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 280, 12
    LTEXT "Name contains:", -1, 12, 33, 80, 12
    EDITTEXT IDC_RECENT_NAME, 96, 31, 202, 14, ES_AUTOHSCROLL
    LTEXT "Type:", -1, 12, 57, 80, 12
    COMBOBOX IDC_RECENT_CATEGORY, 96, 55, 202, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Extension:", -1, 12, 81, 80, 12
    EDITTEXT IDC_RECENT_EXTENSION, 96, 79, 202, 14, ES_AUTOHSCROLL
    LTEXT "Leave empty for all extensions, or enter pdf, jpg, md...", -1, 96, 97, 202, 20
    LTEXT "Sort by Recent entry updated using Explorer's Sort menu or the column in Details view. This is the Windows recent shortcut's update time, not the document's last-opened time.", -1, 12, 123, 286, 28
    DEFPUSHBUTTON "Apply", IDOK, 182, 161, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 242, 161, 56, 14
END


#include <winres.h>
#pragma code_page(65001)
#include "resource.h"

IDI_APP ICON "App.ico"

#include "Strings.rc2"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#include "Dialogs.rc2"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
#ifdef MCOS_EXECUTABLE
 FILETYPE VFT_APP
#else
 FILETYPE VFT_DLL
#endif
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Umberto Giacobbi | umbertogiacobbi.biz"
            VALUE "FileDescription", "MyComputerOnSteroid native launcher"
            VALUE "FileVersion", "0.0.0.0"
            VALUE "InternalName", "MyComputerOnSteroid"
            VALUE "LegalCopyright", "Copyright (c) 2026 Umberto Giacobbi"
#ifdef MCOS_EXECUTABLE
            VALUE "OriginalFilename", "MyComputerOnSteroid.exe"
#else
            VALUE "OriginalFilename", "MyComputerOnSteroid.Shell.dll"
#endif
            VALUE "ProductName", "MyComputerOnSteroid"
            VALUE "ProductVersion", "Unreleased"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
